# Absolute path on persistent private storage, outside public/ and temporary folders.
# Required for the priority-list API. No fallback or success without storage.
THREERACE_PRIORITY_DB_PATH="/absolute/persistent/path/lista-prioritaria.sqlite"
# Exact public origin used by the browser (no trailing slash/path).
THREERACE_PRIORITY_ORIGIN="http://127.0.0.1:3001"
